# Render / production environment variables (set these in the Render dashboard)
# Do NOT put real secrets in this file.

GROQ_API_KEY=
FLASK_SECRET_KEY=

# Firebase Auth (optional — Google Sign-In)
# FIREBASE_WEB_CONFIG = JSON string with apiKey, authDomain, projectId, appId, ...
# FIREBASE_SERVICE_ACCOUNT_JSON = full service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_PATH = local path to service account JSON (dev only)
# FIREBASE_WEB_CONFIG=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: only used by Vercel serverless path
# VERCEL=

# Firestore: enable Firestore Database in Firebase Console (same project / service account).
# Living Notebook sync uses Admin SDK; no extra env vars beyond FIREBASE_SERVICE_ACCOUNT_JSON.
