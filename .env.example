# Render / production environment variables (set these in the Render dashboard)
# Do NOT put real secrets in this file.

GROQ_API_KEY=
FLASK_SECRET_KEY=

# Custom domain (set after you attach the domain on Render)
# Comma-separated origins if the UI is served from a different host than the API
# Example: https://studybuddy.yourschool.com,https://www.studybuddy.yourschool.com
# CORS_ORIGINS=

# Session cookies (auto-secure on Render; override only if needed)
# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_DAYS=60
# SESSION_COOKIE_DOMAIN=

# Diagram photos (optional). If missing, diagrams fall back to Groq SVG.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Firebase Auth (optional — Google Sign-In)
# FIREBASE_WEB_CONFIG = JSON string with apiKey, authDomain, projectId, appId, ...
# FIREBASE_SERVICE_ACCOUNT_JSON = full service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_PATH = local path to service account JSON (dev only)
# FIREBASE_WEB_CONFIG=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=
#
# After custom domain: add the domain under Firebase Console → Authentication → Settings → Authorized domains.

# Optional: only used by Vercel serverless path
# VERCEL=

# Firestore: enable Firestore Database in Firebase Console (same project / service account).
# Living Notebook sync uses Admin SDK; no extra env vars beyond FIREBASE_SERVICE_ACCOUNT_JSON.
