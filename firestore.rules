rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Study Buddy server uses the Admin SDK (bypasses these rules).
    // These rules protect any accidental client-side Firestore access.

    function signedIn() {
      return request.auth != null;
    }

    function ownsFbDoc(userDocId) {
      return signedIn()
        && userDocId is string
        && userDocId.matches('fb:.*')
        && userDocId == ('fb:' + request.auth.uid);
    }

    // Deny all client reads/writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Optional: allow a signed-in Firebase user to read ONLY their own fb:{uid} tree
    // (local:* and uid:* docs stay server-only).
    match /users/{userDocId} {
      allow read: if ownsFbDoc(userDocId);
      allow write: if false;

      match /{sub=**} {
        allow read: if ownsFbDoc(userDocId);
        allow write: if false;
      }
    }
  }
}
